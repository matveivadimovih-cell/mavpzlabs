@startuml
left to right direction

package "Персонал"{
    actor "Бібліотекар" as lib
    actor "Старший бібліотекар" as sLib 
}

actor "Сервіс білінгу" as bil

sLib -|> lib 

rectangle "Система бібліотеки"{
    usecase "Зареєструвати читача" as UCRegister
    usecase "Ідентифікувати примірник" as UCIdentifyCopy
    usecase "Ідентифікувати читача" as UCIdentifyReader
    usecase "Переглянути інформацію про читача" as UCViewReaderInfo
    usecase "Перевірити наявність видання" as UCFindPublication
    usecase "Видати примірник" as UCIssue
    usecase "Оформити повернення примірника" as UCReturn
    usecase "Зафіксувати погіршення стану примірника" as UCRecord
    usecase "Надіслати запит на коригування штрафу" as UCManageFines

    usecase "Керувати каталогом видань" as UCManagePublication
    usecase "Керувати каталогом примірників" as UCManageCopy
    usecase "Змінити статус читача вручну" as UCChangeReaderStatus

    usecase "Обробити сповіщення про сплату штрафу" as UCNotifyFinePayment
}

lib --> UCIssue
lib --> UCReturn
lib --> UCFindPublication
lib --> UCRegister
lib --> UCViewReaderInfo

sLib --> UCManagePublication
sLib --> UCManageCopy
sLib --> UCChangeReaderStatus
sLib --> UCManageFines

UCRecord --> bil
UCManageFines --> bil
bil -left-> UCNotifyFinePayment

UCRecord ..> UCReturn : <<extend>>
UCIssue ..> UCIdentifyReader : <<include>>
UCViewReaderInfo ..> UCIdentifyReader : <<include>>
UCIssue ..> UCIdentifyCopy : <<include>>
UCReturn ..> UCIdentifyCopy : <<include>>

@enduml